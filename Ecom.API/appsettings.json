{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EcomDatabase": "YOUR_DATABASE_CONNECTION_STRING",
    "redis": "YOUR_REDIS_CONNECTION_STRING"
  },
  "EmailSetting": {
    "From": "YOUR_EMAIL",
    "Smtp": "YOUR_SMTP_SERVER",
    "Port": 587,
    "Username": "YOUR_EMAIL_USERNAME",
    "Password": "YOUR_EMAIL_PASSWORD"
  },
  "Token": {
    "Secret": "YOUR_JWT_SECRET",
    "Issuer": "EcomAPI"
  }
}
